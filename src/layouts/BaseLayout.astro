---
import "@/styles.css";
import "@/styles/site-base.css";
import "@/styles/landing-core.css";
import "@/styles/landing-ecosystem.css";
import "@/styles/landing-secondary.css";

import { packageVersion, productLinks } from "@/content";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

if (!Astro.site) {
  throw new Error("Astro site URL is required for canonical metadata.");
}

const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImageUrl = new URL("/og-friction.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site.href}#website`,
      url: Astro.site.href,
      name: "Friction",
      description,
      inLanguage: "en",
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${Astro.site.href}#software`,
      name: "Friction",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Windows, macOS, Linux",
      softwareRequirements: "Node.js 24 or newer",
      softwareVersion: packageVersion,
      description,
      url: Astro.site.href,
      downloadUrl: productLinks.npm,
      sameAs: [productLinks.github, productLinks.npm],
      isAccessibleForFree: true,
      license: "https://opensource.org/license/mit",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
const analyticsConfigScript = [
  "window.dataLayer = window.dataLayer || [];",
  "function gtag(){window.dataLayer.push(arguments);}",
  "gtag('js', new Date());",
  "gtag('config', 'G-HMVDT8P4W3');",
].join("\n");
const tagManagerScript = [
  "(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':",
  "new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],",
  "j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=",
  "'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);",
  "})(window,document,'script','dataLayer','GTM-PB7B63SH');",
].join("\n");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#060606" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    {
      import.meta.env.PROD && (
        <>
          <script is:inline set:html={tagManagerScript}></script>
          <script
            is:inline
            async
            fetchpriority="low"
            src="https://www.googletagmanager.com/gtag/js?id=G-HMVDT8P4W3"
          ></script>
          <script is:inline set:html={analyticsConfigScript}></script>
        </>
      )
    }

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Friction" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta
      property="og:image:alt"
      content="Friction terminal logo on a black background"
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1392" />
    <meta property="og:image:height" content="768" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Friction terminal logo on a black background"
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={structuredDataJson}
    ></script>
  </head>
  <body>
    {
      import.meta.env.PROD && (
        <noscript>
          <iframe
            src="https://www.googletagmanager.com/ns.html?id=GTM-PB7B63SH"
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          ></iframe>
        </noscript>
      )
    }
    <slot />
  </body>
</html>
