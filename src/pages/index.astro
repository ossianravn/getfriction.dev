---
import {
  ArrowRight,
  FileWarning,
  MessageSquareText,
  SearchCheck,
  Wrench,
} from "lucide-react";

import { BrandMark } from "@/components/brand-mark";
import { CaptureTerminal } from "@/components/capture-terminal";
import { InstallCommand } from "@/components/install-command";
import { ProductLinks } from "@/components/product-links";
import {
  changelog,
  integrationGroups,
  openConventions,
  packageVersion,
  privacyFacts,
  productLinks,
  workflow,
} from "@/content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Friction - Local-first feedback for engineering agents";
const description =
  "Friction gives engineering agents a private, local-first place to capture recurring workflow obstacles, review verified causes, and fix them only when you choose.";
const workflowIcons = [MessageSquareText, FileWarning, SearchCheck, Wrench];
---

<BaseLayout title={title} description={description}>
  <div class="site-shell" id="top">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <BrandMark compact />
      <nav aria-label="Primary">
        <ul>
          <li><a href="#loop">How it works</a></li>
          <li><a href="#integrations">Integrations</a></li>
          <li><a href="#privacy">Privacy</a></li>
          <li><a href="#changelog">Changelog</a></li>
        </ul>
      </nav>
      <ProductLinks />
    </header>

    <main id="main" tabindex="-1">
      <section class="hero">
        <p class="eyebrow">Local-first feedback for engineering agents</p>
        <h1>
          Your agent finished the task.
          <span>Friction remembers what made it harder.</span>
        </h1>
        <p class="hero__lede">
          Give your engineering agents a private place to record recurring
          obstacles - then review and fix verified causes when you choose.
        </p>
        <InstallCommand client:load />
        <ul aria-label="Package details" class="hero__meta">
          <li>v{packageVersion}</li>
          <li>Node.js 24+</li>
          <li>MIT</li>
        </ul>
      </section>

      <section class="loop" id="loop" aria-labelledby="loop-heading">
        <div class="section-heading section-heading--centered">
          <p class="eyebrow">The feedback loop</p>
          <h2 id="loop-heading">Keep the task moving. Keep the lesson.</h2>
        </div>
        <ol class="loop__steps">
          {
            workflow.map((step, index) => {
              const Icon = workflowIcons[index];

              return (
                <li>
                  <div class="loop__marker">
                    <Icon aria-hidden="true" />
                    <p>{step.number}</p>
                  </div>
                  <h3>{step.title}</h3>
                  <span>{step.body}</span>
                </li>
              );
            })
          }
        </ol>
        <p class="loop__note">
          Nothing runs in the background. Review, fixing, and sharing are
          separate decisions.
        </p>
      </section>

      <section
        class="conventions"
        id="conventions"
        aria-labelledby="conventions-heading"
      >
        <div class="section-heading section-heading--wide">
          <p class="eyebrow">Built on open conventions</p>
          <h2 id="conventions-heading">Three layers. One private loop.</h2>
          <p>
            Persistent guidance captures the obstacle. Skills make review and
            fixing explicit. The CLI keeps the original evidence local.
          </p>
        </div>
        <ol class="conventions__list">
          {
            openConventions.map((convention) => (
              <li>
                <div class="conventions__meta">
                  <span>{convention.number}</span>
                  <p>{convention.label}</p>
                </div>
                <h3><code>{convention.title}</code></h3>
                <p>{convention.body}</p>
                <code class="conventions__command">{convention.command}</code>
              </li>
            ))
          }
        </ol>
        <p class="conventions__note">
          <code>.agents/skills</code> is a preferred cross-client convention
          where supported - not a universal installation path.
        </p>
      </section>
      <section class="capture" aria-labelledby="capture-heading">
        <div class="section-heading">
          <p class="eyebrow">Saved observations</p>
          <h2 id="capture-heading">
            The problems successful tasks usually hide.
          </h2>
          <p>
            Each note keeps the work, obstacle, cost, and repository context
            together - without collecting a transcript.
          </p>
        </div>
        <CaptureTerminal client:visible />
      </section>

      <section
        class="integrations"
        id="integrations"
        aria-labelledby="integrations-heading"
      >
        <div class="section-heading section-heading--wide">
          <p class="eyebrow">Integration status</p>
          <h2 id="integrations-heading">Specific support. Honest boundaries.</h2>
          <p>
            Friction uses a deterministic setup catalog. A documented file
            convention alone does not become a support claim. Run{" "}
            <code>friction setup --list</code> for exact scopes and caveats.
          </p>
        </div>
        <div class="integrations__list">
          {
            integrationGroups.map((group) => (
              <section>
                <div class="integrations__status">
                  <h3>{group.status}</h3>
                  <p>{group.description}</p>
                </div>
                <ul>
                  {group.items.map((integration) => (
                    <li>
                      <div>
                        <strong>{integration.name}</strong>
                        <span>{integration.scope}</span>
                      </div>
                      <p>{integration.note}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <aside class="integrations__release-note" aria-label="Release status">
          <span>Release boundary</span>
          <p>
            The expanded setup catalog is prepared for Friction 0.2.0. npm
            remains at v{packageVersion} until the separately approved package
            release.
          </p>
        </aside>
      </section>

      <section class="privacy" id="privacy" aria-labelledby="privacy-heading">
        <div class="section-heading section-heading--wide">
          <p class="eyebrow">Private by default</p>
          <h2 id="privacy-heading">Local means local.</h2>
          <p>
            The CLI is deterministic and model-free. Your engineering agent
            does the reasoning only when you ask.
          </p>
        </div>
        <ul class="privacy__grid">
          {
            privacyFacts.map((fact, index) => (
              <li>
                <span>0{index + 1}</span>
                {fact}
              </li>
            ))
          }
        </ul>
        <p class="privacy__runtime">
          Remote and sandboxed agents need Friction installed inside that
          environment. Your local private store is not uploaded or synchronized.
        </p>
      </section>

      <section
        class="changelog"
        id="changelog"
        aria-labelledby="changelog-heading"
      >
        <div class="section-heading">
          <p class="eyebrow">Changelog</p>
          <h2 id="changelog-heading">Small releases, visible progress.</h2>
        </div>
        <div class="changelog__list">
          {
            changelog.map((release) => (
              <article>
                <div>
                  <h3>v{release.version}</h3>
                  <time datetime={release.dateTime}>{release.date}</time>
                </div>
                <ul>
                  {release.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <a class="text-link" href={productLinks.github}>
          Follow development on GitHub <ArrowRight aria-hidden="true" />
        </a>
      </section>

      <section class="final-cta" aria-labelledby="final-heading">
        <BrandMark />
        <h2 id="final-heading">Let completed tasks improve the next one.</h2>
        <InstallCommand client:visible />
      </section>
    </main>

    <footer class="site-footer">
      <p>Friction is open source under the MIT License.</p>
      <p>Built for one developer and their engineering agents.</p>
    </footer>
  </div>
</BaseLayout>
